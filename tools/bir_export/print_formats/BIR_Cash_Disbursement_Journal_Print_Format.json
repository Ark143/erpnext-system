  "raw_printing": 0,
  "html": "<div class=\"bir-cdj-print\">\n    <style>\n        .bir-cdj-print {\n            font-family: \"Segoe UI\", Arial, sans-serif;\n            color: #000;\n            background-color: #fff;\n            padding: 5px;\n        }\n        .bir-header-sap {\n            margin-bottom: 12px;\n            border-bottom: 2px solid #000;\n            padding-bottom: 8px;\n        }\n        .bir-header-sap h2 {\n            text-align: center;\n            font-weight: bold;\n            text-transform: uppercase;\n            margin-top: 0;\n            margin-bottom: 10px;\n            font-size: 16px;\n            letter-spacing: 0.5px;\n        }\n        .sap-metadata-table {\n            width: 100%;\n            border-collapse: collapse;\n            font-size: 9.5px;\n            line-height: 1.3;\n        }\n        .sap-metadata-table td {\n            padding: 2px 4px !important;\n            border: none !important;\n        }\n        .sap-metadata-table td.label-cell {\n            font-weight: bold;\n            width: 12%;\n            text-align: left;\n        }\n        .sap-metadata-table td.value-cell {\n            width: 38%;\n            text-align: left;\n        }\n        .bir-period {\n            font-size: 11px;\n            font-weight: bold;\n            margin-top: 5px;\n            margin-bottom: 8px;\n            text-transform: uppercase;\n        }\n        .bir-table {\n            width: 100%;\n            border-collapse: collapse;\n            margin-bottom: 20px;\n            font-size: 9px;\n        }\n        .bir-table th, .bir-table td {\n            border: 1px solid #000;\n            padding: 4px 5px;\n            text-align: left;\n            white-space: nowrap; /* Prevent wrap */\n        }\n        .bir-table th {\n            background-color: #fff;\n            font-weight: bold;\n            text-align: center;\n            text-transform: uppercase;\n        }\n        .bir-table td.num-cell {\n            text-align: right;\n        }\n        .bir-table tr.total-row {\n            font-weight: bold;\n        }\n        .bir-summary-section {\n            margin-top: 15px;\n            page-break-inside: avoid;\n        }\n        .bir-summary-section h3 {\n            font-size: 11px;\n            font-weight: bold;\n            text-transform: uppercase;\n            margin-bottom: 8px;\n            border-bottom: 1px solid #000;\n            padding-bottom: 2px;\n            width: fit-content;\n        }\n    </style>\n\n    <div class=\"bir-header-sap\">\n        <h2>BIR Cash Disbursement Journal</h2>\n        <table class=\"sap-metadata-table\">\n            <tr>\n                <td class=\"label-cell\">Company:</td>\n                <td class=\"value-cell\">{{ doc.company }}</td>\n                <td class=\"label-cell\">Line of Business:</td>\n                <td class=\"value-cell\">{{ doc.line_of_business or '' }}</td>\n            </tr>\n            <tr>\n                <td class=\"label-cell\">Address:</td>\n                <td class=\"value-cell\">{{ doc.address_display or 'Davao City, Davao Del Sur' }}</td>\n                <td class=\"label-cell\">Zip:</td>\n                <td class=\"value-cell\">{{ doc.zip or '' }}</td>\n            </tr>\n            <tr>\n                <td class=\"label-cell\">TIN:</td>\n                <td class=\"value-cell\">{{ doc.tin or '' }}</td>\n                <td class=\"label-cell\">Email:</td>\n                <td class=\"value-cell\">{{ doc.email or '' }}</td>\n            </tr>\n            <tr>\n                <td class=\"label-cell\">RDO:</td>\n                <td class=\"value-cell\">{{ doc.rdo or '' }}</td>\n                <td class=\"label-cell\">Mobile / Tel:</td>\n                <td class=\"value-cell\">\n                    {{ doc.mobile or '' }}{% if doc.telephone %} / {{ doc.telephone }}{% endif %}\n                </td>\n            </tr>\n        </table>\n    </div>\n\n    <div class=\"bir-period\">\n        Period: {{ frappe.format(doc.from_date, {fieldtype: 'Date'}) if doc.from_date else '' }} to {{ frappe.format(doc.to_date, {fieldtype: 'Date'}) if doc.to_date else '' }}\n    </div>\n\n    <table class=\"bir-table\">\n        <thead>\n            <tr>\n                <th>Date</th>\n                <th>Payee</th>\n                <th>TIN</th>\n                <th>Invoice No.</th>\n                <th>Nature</th>\n                <th>Discount Type</th>\n                <th>Discount Amount</th>\n                <th>VATable</th>\n                <th>Input VAT</th>\n                <th>Zero</th>\n                <th>Exempt</th>\n                <th>Total</th>\n                <th>EWT</th>\n                <th>Net Paid</th>\n                <th>Status</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% set totals = {\n                'discount': 0.0,\n                'vatable': 0.0,\n                'input_vat': 0.0,\n                'zero': 0.0,\n                'exempt': 0.0,\n                'total': 0.0,\n                'ewt': 0.0,\n                'net_paid': 0.0\n            } %}\n            {% for row in doc.journal_entries %}\n                <tr>\n                    <td style=\"white-space: nowrap;\">{{ frappe.format(row.date, {fieldtype: 'Date'}) if row.date else '' }}</td>\n                    <td>{{ row.payee or '' }}</td>\n                    <td>{{ row.tin or '' }}</td>\n                    <td>{{ row.invoice_no or '' }}</td>\n                    <td>{{ row.nature or '' }}</td>\n                    <td>{{ row.discount_type or 'NONE' }}</td>\n                    <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.discount_amount or 0) }}</td>\n                    <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.vatable or 0) }}</td>\n                    <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.input_vat or 0) }}</td>\n                    <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.zero or 0) }}</td>\n                    <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.exempt or 0) }}</td>\n                    <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.total or 0) }}</td>\n                    <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.ewt or 0) }}</td>\n                    <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.net_paid or 0) }}</td>\n                    <td style=\"font-weight: bold; text-align: center; color: #000;\">{{ row.status or '' }}</td>\n                </tr>\n                {% if totals.update({\n                    'discount': totals.discount + (row.discount_amount or 0),\n                    'vatable': totals.vatable + (row.vatable or 0),\n                    'input_vat': totals.input_vat + (row.input_vat or 0),\n                    'zero': totals.zero + (row.zero or 0),\n                    'exempt': totals.exempt + (row.exempt or 0),\n                    'total': totals.total + (row.total or 0),\n                    'ewt': totals.ewt + (row.ewt or 0),\n                    'net_paid': totals.net_paid + (row.net_paid or 0)\n                }) %}{% endif %}\n            {% endfor %}\n            <tr class=\"total-row\">\n                <td colspan=\"6\">TOTAL</td>\n                <td class=\"num-cell\">{{ \"{:,.2f}\".format(totals.discount) }}</td>\n                <td class=\"num-cell\">{{ \"{:,.2f}\".format(totals.vatable) }}</td>\n                <td class=\"num-cell\">{{ \"{:,.2f}\".format(totals.input_vat) }}</td>\n                <td class=\"num-cell\">{{ \"{:,.2f}\".format(totals.zero) }}</td>\n                <td class=\"num-cell\">{{ \"{:,.2f}\".format(totals.exempt) }}</td>\n                <td class=\"num-cell\">{{ \"{:,.2f}\".format(totals.total) }}</td>\n                <td class=\"num-cell\">{{ \"{:,.2f}\".format(totals.ewt) }}</td>\n                <td class=\"num-cell\">{{ \"{:,.2f}\".format(totals.net_paid) }}</td>\n                <td></td>\n            </tr>\n        </tbody>\n    </table>\n\n    <div class=\"bir-summary-section\">\n        <h3>Account Summary</h3>\n        <table class=\"bir-table\" style=\"width: 50%;\">\n            <thead>\n                <tr>\n                    <th>Account Title</th>\n                    <th>Debit</th>\n                    <th>Credit</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for row in doc.account_summary %}\n                    <tr class=\"{% if row.account_title == 'Total' %}total-row{% endif %}\">\n                        <td>{{ row.account_title }}</td>\n                        <td class=\"num-cell\">{% if row.debit > 0 or row.account_title == 'Total' %}{{ \"{:,.2f}\".format(row.debit or 0) }}{% endif %}</td>\n                        <td class=\"num-cell\">{% if row.credit > 0 or row.account_title == 'Total' %}{{ \"{:,.2f}\".format(row.credit or 0) }}{% endif %}</td>\n                    </tr>\n                {% endfor %}\n            </tbody>\n        </table>\n    </div>\n</div>",
  "margin_top": 15.0,
  "margin_bottom": 15.0,
  "margin_left": 15.0,
  "margin_right": 15.0,
