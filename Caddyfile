http://erp.localhost, http://localhost, :8080, :80 {
    handle /socket.io/* {
        reverse_proxy 127.0.0.1:9000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    handle {
        reverse_proxy 127.0.0.1:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }
}
