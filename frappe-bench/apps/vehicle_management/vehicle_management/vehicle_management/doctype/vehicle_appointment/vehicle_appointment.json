{
 "doctype": "DocType",
 "name": "Vehicle Appointment",
 "module": "Vehicle Management",
 "custom": 0,
 "is_submittable": 0,
 "istable": 0,
 "editable_grid": 0,
 "track_changes": 1,
 "engine": "InnoDB",
 "autoname": "naming_series:",
 "naming_rule": null,
 "search_fields": "plate_no,customer_name,customer_phone,service_type,branch",
 "title_field": "customer_name",
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "options": "APT-.YYYY.-.#####",
   "default": "APT-.YYYY.-.#####",
   "label": "Series",
   "reqd": 1
  },
  {
   "fieldname": "branch",
   "fieldtype": "Link",
   "options": "Company",
   "label": "Branch / Location",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "appointment_date",
   "fieldtype": "Date",
   "label": "Appointment Date",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "appointment_time",
   "fieldtype": "Select",
   "options": "08:00 AM - 10:00 AM\n10:00 AM - 12:00 PM\n01:00 PM - 03:00 PM\n03:00 PM - 05:00 PM",
   "label": "Time Slot",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "options": "Requested\nConfirmed\nIn Progress\nCompleted\nCancelled\nNo Show",
   "default": "Requested",
   "label": "Status",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "sec_cust_info",
   "fieldtype": "Section Break",
   "label": "Customer Information"
  },
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "options": "Customer",
   "label": "Customer Link",
   "in_list_view": 1
  },
  {
   "fieldname": "customer_name",
   "fieldtype": "Data",
   "label": "Customer Name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "col_cust_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "customer_phone",
   "fieldtype": "Data",
   "label": "Mobile / Phone",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "customer_email",
   "fieldtype": "Data",
   "label": "Email Address"
  },
  {
   "fieldname": "sec_vehicle_info",
   "fieldtype": "Section Break",
   "label": "Vehicle Information"
  },
  {
   "fieldname": "vehicle",
   "fieldtype": "Link",
   "options": "Customer Vehicle",
   "label": "Vehicle Link"
  },
  {
   "fieldname": "plate_no",
   "fieldtype": "Data",
   "label": "Plate No / Conduction Sticker",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "make",
   "fieldtype": "Link",
   "options": "Vehicle Make",
   "label": "Make"
  },
  {
   "fieldname": "col_veh_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "model",
   "fieldtype": "Link",
   "options": "Vehicle Model",
   "label": "Model"
  },
  {
   "fieldname": "year",
   "fieldtype": "Data",
   "label": "Year Model"
  },
  {
   "fieldname": "color",
   "fieldtype": "Data",
   "label": "Color"
  },
  {
   "fieldname": "sec_service_details",
   "fieldtype": "Section Break",
   "label": "Service Details & Requests"
  },
  {
   "fieldname": "service_type",
   "fieldtype": "Select",
   "options": "PMS / Change Oil\nTires & Wheels\nWheel Alignment & Balancing\nBrake System Service\nUnderchassis & Suspension\nCar Aircon Service\nEngine Diagnostics & Tune-up\nCar Wash & Detailing\nBattery & Electrical\nGeneral Mechanical Repair",
   "label": "Primary Service Requested",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Customer Notes / Special Requests"
  },
  {
   "fieldname": "col_service_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "job_order",
   "fieldtype": "Link",
   "options": "Vehicle Job Order",
   "label": "Linked Job Order",
   "read_only": 1
  },
  {
   "fieldname": "estimate",
   "fieldtype": "Link",
   "options": "Vehicle Estimate",
   "label": "Linked Estimate",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Desk User",
   "read": 1,
   "write": 1,
   "create": 1
  }
 ]
}
