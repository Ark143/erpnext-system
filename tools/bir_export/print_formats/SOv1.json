  "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<style>\r\n  @page {\r\n    size: A4 portrait;\r\n    margin: 12mm 15mm 15mm 15mm;\r\n  }\r\n\r\n  * {\r\n    box-sizing: border-box;\r\n    -webkit-print-color-adjust: exact !important;\r\n    print-color-adjust: exact !important;\r\n  }\r\n\r\n  body {\r\n    font-family: -apple-system, BlinkMacSystemFont, \"SF Pro Display\", \"SF Pro Text\", \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\r\n    color: #1d1d1f;\r\n    background-color: #ffffff;\r\n    font-size: 13px;\r\n    line-height: 1.47059;\r\n    font-weight: 400;\r\n    letter-spacing: -0.022em;\r\n    margin: 0;\r\n    padding: 0;\r\n  }\r\n\r\n  .print-container {\r\n    width: 100%;\r\n    max-width: 800px;\r\n    margin: 0 auto;\r\n    background: #ffffff;\r\n  }\r\n\r\n  /* Apple Header Section */\r\n  .apple-header {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: flex-start;\r\n    padding-bottom: 22px;\r\n    border-bottom: 1px solid rgba(0, 0, 0, 0.08);\r\n    margin-bottom: 24px;\r\n  }\r\n\r\n  .brand-logo {\r\n    max-height: 44px;\r\n    max-width: 180px;\r\n    object-fit: contain;\r\n    margin-bottom: 6px;\r\n  }\r\n\r\n  .company-title {\r\n    font-size: 19px;\r\n    font-weight: 600;\r\n    letter-spacing: -0.015em;\r\n    color: #1d1d1f;\r\n  }\r\n\r\n  .company-address {\r\n    font-size: 11px;\r\n    color: #86868b;\r\n    margin-top: 4px;\r\n    line-height: 1.4;\r\n  }\r\n\r\n  .doc-title-container {\r\n    text-align: right;\r\n  }\r\n\r\n  .doc-type-badge {\r\n    display: inline-block;\r\n    padding: 3px 10px;\r\n    font-size: 10px;\r\n    font-weight: 600;\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.06em;\r\n    background: rgba(0, 113, 227, 0.08);\r\n    color: #0071e3;\r\n    border-radius: 980px;\r\n    margin-bottom: 6px;\r\n  }\r\n\r\n  .doc-id {\r\n    font-size: 24px;\r\n    font-weight: 700;\r\n    letter-spacing: -0.025em;\r\n    color: #1d1d1f;\r\n    margin: 2px 0;\r\n  }\r\n\r\n  .status-pill {\r\n    display: inline-block;\r\n    padding: 2px 8px;\r\n    font-size: 11px;\r\n    font-weight: 500;\r\n    border-radius: 980px;\r\n    background: #f5f5f7;\r\n    color: #86868b;\r\n  }\r\n\r\n  .status-submitted { background: #e8f5e9; color: #2e7d32; }\r\n  .status-completed { background: #e3f2fd; color: #1565c0; }\r\n  .status-draft { background: #fff3e0; color: #ef6c00; }\r\n\r\n  /* Info Cards Grid */\r\n  .apple-grid {\r\n    display: flex;\r\n    gap: 16px;\r\n    margin-bottom: 24px;\r\n  }\r\n\r\n  .apple-card {\r\n    flex: 1;\r\n    background: #fbfbfd;\r\n    border: 1px solid rgba(0, 0, 0, 0.04);\r\n    border-radius: 12px;\r\n    padding: 14px 18px;\r\n    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);\r\n  }\r\n\r\n  .card-label {\r\n    font-size: 10px;\r\n    font-weight: 600;\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.06em;\r\n    color: #86868b;\r\n    margin-bottom: 8px;\r\n  }\r\n\r\n  .card-title {\r\n    font-size: 14px;\r\n    font-weight: 600;\r\n    color: #1d1d1f;\r\n    margin-bottom: 4px;\r\n  }\r\n\r\n  .card-text {\r\n    font-size: 11px;\r\n    color: #515154;\r\n    line-height: 1.5;\r\n  }\r\n\r\n  .meta-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n  }\r\n\r\n  .meta-table td {\r\n    padding: 3px 0;\r\n    font-size: 11px;\r\n  }\r\n\r\n  .meta-label {\r\n    color: #86868b;\r\n    width: 45%;\r\n    font-weight: 400;\r\n  }\r\n\r\n  .meta-value {\r\n    color: #1d1d1f;\r\n    font-weight: 500;\r\n    text-align: right;\r\n  }\r\n\r\n  /* Items Table */\r\n  .table-container {\r\n    border: 1px solid rgba(0, 0, 0, 0.06);\r\n    border-radius: 12px;\r\n    overflow: hidden;\r\n    margin-bottom: 24px;\r\n    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);\r\n  }\r\n\r\n  .items-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    background: #ffffff;\r\n  }\r\n\r\n  .items-table th {\r\n    background: #f5f5f7;\r\n    color: #86868b;\r\n    font-weight: 600;\r\n    font-size: 10px;\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.05em;\r\n    padding: 10px 14px;\r\n    text-align: left;\r\n    border-bottom: 1px solid rgba(0, 0, 0, 0.06);\r\n  }\r\n\r\n  .items-table td {\r\n    padding: 12px 14px;\r\n    border-bottom: 1px solid rgba(0, 0, 0, 0.04);\r\n    font-size: 12px;\r\n    color: #1d1d1f;\r\n    vertical-align: middle;\r\n  }\r\n\r\n  .items-table tr:last-child td {\r\n    border-bottom: none;\r\n  }\r\n\r\n  .item-code {\r\n    font-weight: 600;\r\n    color: #1d1d1f;\r\n    font-size: 12px;\r\n  }\r\n\r\n  .item-desc {\r\n    color: #86868b;\r\n    font-size: 11px;\r\n    margin-top: 2px;\r\n    line-height: 1.3;\r\n  }\r\n\r\n  .item-image {\r\n    width: 32px;\r\n    height: 32px;\r\n    border-radius: 6px;\r\n    object-fit: cover;\r\n    border: 1px solid rgba(0, 0, 0, 0.08);\r\n    margin-right: 10px;\r\n    float: left;\r\n  }\r\n\r\n  .text-right { text-align: right; }\r\n  .text-center { text-align: center; }\r\n\r\n  /* Summary Section */\r\n  .summary-wrapper {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: flex-start;\r\n    gap: 16px;\r\n    margin-bottom: 24px;\r\n    page-break-inside: avoid;\r\n  }\r\n\r\n  .notes-card {\r\n    flex: 1;\r\n    background: #fbfbfd;\r\n    border-radius: 12px;\r\n    padding: 14px 16px;\r\n    border: 1px solid rgba(0, 0, 0, 0.04);\r\n  }\r\n\r\n  .totals-card {\r\n    width: 300px;\r\n    background: #fbfbfd;\r\n    border-radius: 12px;\r\n    padding: 16px 18px;\r\n    border: 1px solid rgba(0, 0, 0, 0.04);\r\n    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);\r\n  }\r\n\r\n  .summary-row {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    padding: 4px 0;\r\n    font-size: 12px;\r\n    color: #515154;\r\n  }\r\n\r\n  .summary-row.tax-row {\r\n    color: #86868b;\r\n    font-size: 11px;\r\n  }\r\n\r\n  .summary-divider {\r\n    height: 1px;\r\n    background: rgba(0, 0, 0, 0.08);\r\n    margin: 8px 0;\r\n  }\r\n\r\n  .grand-total-row {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: baseline;\r\n    padding-top: 4px;\r\n  }\r\n\r\n  .grand-total-label {\r\n    font-size: 13px;\r\n    font-weight: 600;\r\n    color: #1d1d1f;\r\n  }\r\n\r\n  .grand-total-val {\r\n    font-size: 18px;\r\n    font-weight: 700;\r\n    color: #0071e3;\r\n    letter-spacing: -0.02em;\r\n  }\r\n\r\n  .in-words {\r\n    font-size: 10px;\r\n    color: #86868b;\r\n    text-align: right;\r\n    margin-top: 6px;\r\n    font-style: italic;\r\n  }\r\n\r\n  /* Terms and Conditions */\r\n  .terms-section {\r\n    background: #fbfbfd;\r\n    border: 1px solid rgba(0, 0, 0, 0.04);\r\n    border-radius: 12px;\r\n    padding: 14px 18px;\r\n    margin-bottom: 24px;\r\n    page-break-inside: avoid;\r\n  }\r\n\r\n  .terms-content {\r\n    font-size: 11px;\r\n    color: #515154;\r\n    line-height: 1.5;\r\n  }\r\n\r\n  /* Signatures */\r\n  .signature-grid {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    margin-top: 36px;\r\n    padding-top: 16px;\r\n    page-break-inside: avoid;\r\n  }\r\n\r\n  .sig-box {\r\n    width: 180px;\r\n    text-align: center;\r\n  }\r\n\r\n  .sig-line {\r\n    border-bottom: 1px solid rgba(0, 0, 0, 0.15);\r\n    height: 36px;\r\n    margin-bottom: 6px;\r\n  }\r\n\r\n  .sig-label {\r\n    font-size: 10px;\r\n    color: #86868b;\r\n    font-weight: 500;\r\n  }\r\n\r\n  /* Footer */\r\n  .apple-footer {\r\n    margin-top: 24px;\r\n    padding-top: 14px;\r\n    border-top: 1px solid rgba(0, 0, 0, 0.08);\r\n    display: flex;\r\n    justify-content: space-between;\r\n    font-size: 10px;\r\n    color: #86868b;\r\n  }\r\n\r\n  @media print {\r\n    .print-container { width: 100%; max-width: none; }\r\n    .table-container, .apple-card, .totals-card, .notes-card, .terms-section { break-inside: avoid; }\r\n  }\r\n</style>\r\n</head>\r\n<body>\r\n\r\n<div class=\"print-container\">\r\n  \r\n  <!-- Header -->\r\n  <div class=\"apple-header\">\r\n    <div>\r\n      {% if doc.company_logo %}\r\n        <img src=\"{{ doc.company_logo }}\" class=\"brand-logo\" alt=\"{{ doc.company }}\">\r\n      {% else %}\r\n        <div class=\"company-title\">{{ doc.company }}</div>\r\n      {% endif %}\r\n      {% if doc.company_address_display %}\r\n        <div class=\"company-address\">{{ doc.company_address_display.replace('\\n', ', ') }}</div>\r\n      {% endif %}\r\n    </div>\r\n    \r\n    <div class=\"doc-title-container\">\r\n      <div class=\"doc-type-badge\">{{ doc.select_print_heading or _(\"Sales Order\") }}</div>\r\n      <div class=\"doc-id\">{{ doc.name }}</div>\r\n      <div class=\"status-pill {% if doc.docstatus == 1 %}status-submitted{% elif doc.docstatus == 2 %}status-draft{% else %}status-draft{% endif %}\">\r\n        {% if doc.status %}{{ doc.status }}{% else %}{{ _(\"Draft\") }}{% endif %}\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- Cards Grid: Billing Info & Order Details -->\r\n  <div class=\"apple-grid\">\r\n    <!-- Customer Info -->\r\n    <div class=\"apple-card\">\r\n      <div class=\"card-label\">{{ _(\"Billed To\") }}</div>\r\n      <div class=\"card-title\">{{ doc.customer_name or doc.customer }}</div>\r\n      <div class=\"card-text\">\r\n        {% if doc.address_display %}\r\n          {{ doc.address_display.replace('\\n', '<br>') }}\r\n        {% endif %}\r\n        {% if doc.contact_display %}\r\n          <br><strong>{{ _(\"Contact\") }}:</strong> {{ doc.contact_display }}\r\n        {% endif %}\r\n        {% if doc.contact_mobile %}\r\n          <br><strong>{{ _(\"Mobile\") }}:</strong> {{ doc.contact_mobile }}\r\n        {% endif %}\r\n        {% if doc.tax_id %}\r\n          <br><strong>{{ _(\"Tax ID\") }}:</strong> {{ doc.tax_id }}\r\n        {% endif %}\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Order Metadata -->\r\n    <div class=\"apple-card\">\r\n      <div class=\"card-label\">{{ _(\"Order Information\") }}</div>\r\n      <table class=\"meta-table\">\r\n        <tr>\r\n          <td class=\"meta-label\">{{ _(\"Order Date\") }}</td>\r\n          <td class=\"meta-value\">{{ doc.get_formatted(\"transaction_date\") or \"\" }}</td>\r\n        </tr>\r\n        <tr>\r\n          <td class=\"meta-label\">{{ _(\"Delivery Date\") }}</td>\r\n          <td class=\"meta-value\">{{ doc.get_formatted(\"delivery_date\") or \"-\" }}</td>\r\n        </tr>\r\n        {% if doc.po_no %}\r\n        <tr>\r\n          <td class=\"meta-label\">{{ _(\"Customer PO\") }}</td>\r\n          <td class=\"meta-value\">{{ doc.po_no }}</td>\r\n        </tr>\r\n        {% endif %}\r\n        {% if doc.po_date %}\r\n        <tr>\r\n          <td class=\"meta-label\">{{ _(\"PO Date\") }}</td>\r\n          <td class=\"meta-value\">{{ doc.get_formatted(\"po_date\") or \"-\" }}</td>\r\n        </tr>\r\n        {% endif %}\r\n        {% if doc.currency %}\r\n        <tr>\r\n          <td class=\"meta-label\">{{ _(\"Currency\") }}</td>\r\n          <td class=\"meta-value\">{{ doc.currency }}</td>\r\n        </tr>\r\n        {% endif %}\r\n        {% if doc.project %}\r\n        <tr>\r\n          <td class=\"meta-label\">{{ _(\"Project\") }}</td>\r\n          <td class=\"meta-value\">{{ doc.project }}</td>\r\n        </tr>\r\n        {% endif %}\r\n      </table>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- Items Table -->\r\n  <div class=\"table-container\">\r\n    <table class=\"items-table\">\r\n      <thead>\r\n        <tr>\r\n          <th style=\"width: 5%;\">#</th>\r\n          <th style=\"width: 45%;\">{{ _(\"Item Description\") }}</th>\r\n          <th class=\"text-center\" style=\"width: 12%;\">{{ _(\"Qty\") }}</th>\r\n          <th class=\"text-right\" style=\"width: 18%;\">{{ _(\"Rate\") }}</th>\r\n          <th class=\"text-right\" style=\"width: 20%;\">{{ _(\"Amount\") }}</th>\r\n        </tr>\r\n      </thead>\r\n      <tbody>\r\n        {% for item in doc.items %}\r\n        <tr>\r\n          <td style=\"color: #86868b;\">{{ item.idx }}</td>\r\n          <td>\r\n            {% if item.image %}\r\n              <img src=\"{{ item.image }}\" class=\"item-image\" alt=\"item\">\r\n            {% endif %}\r\n            <div class=\"item-code\">{{ item.item_code }}</div>\r\n            {% if item.item_name and item.item_name != item.item_code %}\r\n              <div style=\"font-weight: 500; color: #515154;\">{{ item.item_name }}</div>\r\n            {% endif %}\r\n            {% if item.description %}\r\n              <div class=\"item-desc\">{{ item.description }}</div>\r\n            {% endif %}\r\n          </td>\r\n          <td class=\"text-center\">\r\n            <span style=\"font-weight: 600;\">{{ item.get_formatted(\"qty\") }}</span>\r\n            <span style=\"color: #86868b; font-size: 11px;\">{{ item.uom or \"\" }}</span>\r\n          </td>\r\n          <td class=\"text-right\">{{ item.get_formatted(\"rate\", doc) }}</td>\r\n          <td class=\"text-right\" style=\"font-weight: 600;\">{{ item.get_formatted(\"amount\", doc) }}</td>\r\n        </tr>\r\n        {% endfor %}\r\n      </tbody>\r\n    </table>\r\n  </div>\r\n\r\n  <!-- Summary Section: Notes & Totals -->\r\n  <div class=\"summary-wrapper\">\r\n    <!-- Notes / Highlights -->\r\n    <div class=\"notes-card\">\r\n      <div class=\"card-label\">{{ _(\"Notes & Highlights\") }}</div>\r\n      <div style=\"font-size: 11px; color: #515154; line-height: 1.5;\">\r\n        {% if doc.notes %}\r\n          {{ doc.notes }}\r\n        {% else %}\r\n          Thank you for your business. Designed for seamless execution and quality standard compliance.\r\n        {% endif %}\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Totals Card -->\r\n    <div class=\"totals-card\">\r\n      <div class=\"summary-row\">\r\n        <span>{{ _(\"Net Total\") }}</span>\r\n        <span>{{ doc.get_formatted(\"net_total\") }}</span>\r\n      </div>\r\n\r\n      {% if doc.taxes %}\r\n        {% for tax in doc.taxes %}\r\n          {% if tax.tax_amount %}\r\n          <div class=\"summary-row tax-row\">\r\n            <span>{{ tax.description or tax.account_head }}</span>\r\n            <span>{{ tax.get_formatted(\"tax_amount\", doc) }}</span>\r\n          </div>\r\n          {% endif %}\r\n        {% endfor %}\r\n      {% endif %}\r\n\r\n      {% if doc.discount_amount %}\r\n      <div class=\"summary-row\" style=\"color: #2e7d32;\">\r\n        <span>{{ _(\"Discount\") }}</span>\r\n        <span>-{{ doc.get_formatted(\"discount_amount\") }}</span>\r\n      </div>\r\n      {% endif %}\r\n\r\n      {% if doc.rounding_adjustment %}\r\n      <div class=\"summary-row tax-row\">\r\n        <span>{{ _(\"Rounding\") }}</span>\r\n        <span>{{ doc.get_formatted(\"rounding_adjustment\") }}</span>\r\n      </div>\r\n      {% endif %}\r\n\r\n      <div class=\"summary-divider\"></div>\r\n\r\n      <div class=\"grand-total-row\">\r\n        <span class=\"grand-total-label\">{{ _(\"Grand Total\") }}</span>\r\n        <span class=\"grand-total-val\">{{ doc.get_formatted(\"grand_total\") }}</span>\r\n      </div>\r\n\r\n      {% if doc.in_words %}\r\n      <div class=\"in-words\">\r\n        {{ doc.in_words }}\r\n      </div>\r\n      {% endif %}\r\n    </div>\r\n  </div>\r\n\r\n  <!-- Terms and Conditions -->\r\n  {% if doc.terms %}\r\n  <div class=\"terms-section\">\r\n    <div class=\"card-label\">{{ _(\"Terms & Conditions\") }}</div>\r\n    <div class=\"terms-content\">\r\n      {{ doc.terms }}\r\n    </div>\r\n  </div>\r\n  {% endif %}\r\n\r\n  <!-- Payment Schedule (if applicable) -->\r\n  {% if doc.payment_schedule %}\r\n  <div class=\"terms-section\">\r\n    <div class=\"card-label\">{{ _(\"Payment Schedule\") }}</div>\r\n    <table class=\"meta-table\" style=\"margin-top: 6px;\">\r\n      <thead>\r\n        <tr style=\"color: #86868b; font-size: 10px; text-transform: uppercase;\">\r\n          <td style=\"width: 40%;\">{{ _(\"Payment Term\") }}</td>\r\n          <td style=\"width: 30%;\">{{ _(\"Due Date\") }}</td>\r\n          <td class=\"text-right\" style=\"width: 30%;\">{{ _(\"Amount\") }}</td>\r\n        </tr>\r\n      </thead>\r\n      <tbody>\r\n        {% for ps in doc.payment_schedule %}\r\n        <tr>\r\n          <td>{{ ps.payment_term or \"-\" }}</td>\r\n          <td>{{ ps.get_formatted(\"due_date\") or \"-\" }}</td>\r\n          <td class=\"text-right\" style=\"font-weight: 500;\">{{ ps.get_formatted(\"payment_amount\", doc) }}</td>\r\n        </tr>\r\n        {% endfor %}\r\n      </tbody>\r\n    </table>\r\n  </div>\r\n  {% endif %}\r\n\r\n  <!-- Signatures -->\r\n  <div class=\"signature-grid\">\r\n    <div class=\"sig-box\">\r\n      <div class=\"sig-line\"></div>\r\n      <div class=\"sig-label\">{{ _(\"Prepared By\") }}</div>\r\n    </div>\r\n    <div class=\"sig-box\">\r\n      <div class=\"sig-line\"></div>\r\n      <div class=\"sig-label\">{{ _(\"Authorized Signatory\") }}</div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- Footer -->\r\n  <div class=\"apple-footer\">\r\n    <div>{{ doc.company }} &bull; {{ _(\"Sales Order\") }} {{ doc.name }}</div>\r\n    <div>{{ _(\"Page\") }} <span class=\"page\"></span> {{ _(\"of\") }} <span class=\"topage\"></span></div>\r\n  </div>\r\n\r\n</div>\r\n\r\n</body>\r\n</html>\r\n",
