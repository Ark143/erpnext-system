  "html": "<div class=\"bir-gj-print\">\n    <style>\n        .bir-gj-print {\n            font-family: \"Segoe UI\", Arial, sans-serif;\n            color: #000;\n            background-color: #fff;\n            padding: 5px;\n        }\n        .bir-header-sap {\n            margin-bottom: 12px;\n            border-bottom: 2px solid #000;\n            padding-bottom: 8px;\n        }\n        .bir-header-sap h2 {\n            text-align: center;\n            font-weight: bold;\n            text-transform: uppercase;\n            margin-top: 0;\n            margin-bottom: 10px;\n            font-size: 16px;\n            letter-spacing: 0.5px;\n        }\n        .sap-metadata-table {\n            width: 100%;\n            border-collapse: collapse;\n            font-size: 9.5px;\n            line-height: 1.3;\n        }\n        .sap-metadata-table td {\n            padding: 2px 4px !important;\n            border: none !important;\n        }\n        .sap-metadata-table td.label-cell {\n            font-weight: bold;\n            width: 12%;\n            text-align: left;\n        }\n        .sap-metadata-table td.value-cell {\n            width: 38%;\n            text-align: left;\n        }\n        .bir-period {\n            font-size: 11px;\n            font-weight: bold;\n            margin-top: 5px;\n            margin-bottom: 8px;\n            text-transform: uppercase;\n        }\n        .bir-table {\n            width: 100%;\n            border-collapse: collapse;\n            font-size: 9.5px;\n        }\n        .bir-table th, .bir-table td {\n            border: 1px solid #000;\n            padding: 4px 6px;\n            text-align: left;\n            white-space: nowrap; /* Prevent wrap */\n        }\n        .bir-table th {\n            background-color: #fff;\n            font-weight: bold;\n            text-align: center;\n            text-transform: uppercase;\n        }\n        .bir-table td.num-cell {\n            text-align: right;\n        }\n        .bir-table tr.total-row td {\n            font-weight: bold;\n        }\n    </style>\n\n    <div class=\"bir-header-sap\">\n        <h2>BIR General Journal</h2>\n        <table class=\"sap-metadata-table\">\n            <tr>\n                <td class=\"label-cell\">Company:</td>\n                <td class=\"value-cell\">{{ doc.company }}</td>\n                <td class=\"label-cell\">Line of Business:</td>\n                <td class=\"value-cell\">{{ doc.line_of_business or '' }}</td>\n            </tr>\n            <tr>\n                <td class=\"label-cell\">Address:</td>\n                <td class=\"value-cell\">{{ doc.address_display or 'Davao City, Davao Del Sur' }}</td>\n                <td class=\"label-cell\">Zip:</td>\n                <td class=\"value-cell\">{{ doc.zip or '' }}</td>\n            </tr>\n            <tr>\n                <td class=\"label-cell\">TIN:</td>\n                <td class=\"value-cell\">{{ doc.tin or '' }}</td>\n                <td class=\"label-cell\">Email:</td>\n                <td class=\"value-cell\">{{ doc.email or '' }}</td>\n            </tr>\n            <tr>\n                <td class=\"label-cell\">RDO:</td>\n                <td class=\"value-cell\">{{ doc.rdo or '' }}</td>\n                <td class=\"label-cell\">Mobile / Tel:</td>\n                <td class=\"value-cell\">\n                    {{ doc.mobile or '' }}{% if doc.telephone %} / {{ doc.telephone }}{% endif %}\n                </td>\n            </tr>\n        </table>\n    </div>\n\n    <div class=\"bir-period\">\n        Period: {{ frappe.format(doc.from_date, {fieldtype: 'Date'}) if doc.from_date else '' }} to {{ frappe.format(doc.to_date, {fieldtype: 'Date'}) if doc.to_date else '' }}\n    </div>\n\n    <table class=\"bir-table\">\n        <thead>\n            <tr>\n                <th style=\"width: 12%;\">Date</th>\n                <th style=\"width: 8%;\">Code</th>\n                <th style=\"width: 50%;\">Account Title</th>\n                <th style=\"width: 10%;\">Debit</th>\n                <th style=\"width: 10%;\">Credit</th>\n                <th style=\"width: 10%;\">Status</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% set totals = {'debit': 0.0, 'credit': 0.0} %}\n            {% for row in doc.journal_entries %}\n                {% if row.is_explanation_row %}\n                    <tr>\n                        <td></td>\n                        <td></td>\n                        <td style=\"font-weight: bold; padding-left: 20px;\">{{ row.explanation or '' }}</td>\n                        <td></td>\n                        <td></td>\n                        <td></td>\n                    </tr>\n                {% else %}\n                    <tr>\n                        <td>{{ frappe.format(row.date, {fieldtype: 'Date'}) if row.date else '' }}</td>\n                        <td>{{ row.code or '' }}</td>\n                        <td style=\"{% if row.indent == 2 %}padding-left: 20px;{% endif %}\">{{ row.account_title or '' }}</td>\n                        <td class=\"num-cell\">{% if row.debit > 0 %}{{ \"{:,.2f}\".format(row.debit) }}{% endif %}</td>\n                        <td class=\"num-cell\">{% if row.credit > 0 %}{{ \"{:,.2f}\".format(row.credit) }}{% endif %}</td>\n                        <td style=\"font-weight: bold; text-align: center; color: #000;\">{{ row.status or '' }}</td>\n                    </tr>\n                    {% if totals.update({\n                        'debit': totals.debit + (row.debit or 0),\n                        'credit': totals.credit + (row.credit or 0)\n                    }) %}{% endif %}\n                {% endif %}\n            {% endfor %}\n            <tr class=\"total-row\">\n                <td colspan=\"3\">TOTAL</td>\n                <td class=\"num-cell\">{{ \"{:,.2f}\".format(totals.debit) }}</td>\n                <td class=\"num-cell\">{{ \"{:,.2f}\".format(totals.credit) }}</td>\n                <td></td>\n            </tr>\n        </tbody>\n    </table>\n</div>",
  "margin_top": 15.0,
  "margin_bottom": 15.0,
