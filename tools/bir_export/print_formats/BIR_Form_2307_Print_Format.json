  "html": "<div class=\"bir-2307-container\">\n    <style>\n        /* Force reset of parent wrappers, margins, paddings, headers and footers */\n        html, body, .print-format, .print-format-builder, .print-preview, .print-format-builder-body, [data-doctype=\"BIR Form 2307\"] {\n            margin: 0 !important;\n            padding: 0 !important;\n            border: none !important;\n            background-color: transparent !important;\n            box-shadow: none !important;\n        }\n        .print-heading, .print-format-builder-header, .print-format-builder-footer, .page-break-header, .page-break-footer, .page-break {\n            display: none !important;\n        }\n        \n        /* US Letter Sizing absolute container starting exactly at top-left */\n        .bir-2307-container {\n            width: 8.5in;\n            height: 11in;\n            position: absolute;\n            top: 0;\n            left: 0;\n            background-image: url(\"/files/bir_2307_restored_20260909.png\");\n            background-size: 100% 100% !important;\n            background-repeat: no-repeat;\n            font-family: Arial, sans-serif;\n            color: #000;\n            box-sizing: border-box;\n        }\n        \n        /* General field values style */\n        .field-val {\n            position: absolute;\n            font-size: 11px;\n            font-weight: bold;\n            display: flex;\n            align-items: center;\n        }\n        \n        /* Date elements */\n        .date-digit {\n            position: absolute;\n            width: 1.8%;\n            text-align: center;\n            font-size: 11.5px;\n            font-weight: bold;\n            top: 11.8%; /* Shifted down from 9.38% */\n        }\n\n        /* TIN digits */\n        .tin-digit {\n            position: absolute;\n            width: 1.6%;\n            text-align: center;\n            font-size: 12px;\n            font-weight: bold;\n        }\n\n        /* Part III Table overlay */\n        .table-overlay {\n            position: absolute;\n            left: 2.90%;\n            top: 39.6%; /* Shifted down from 39.08% */\n            width: 94.67%;\n            height: 14.38%;\n        }\n        .overlay-row {\n            position: absolute;\n            width: 100%;\n            display: flex;\n            height: 6.74%;\n            align-items: center;\n        }\n        \n        /* Shift columns to the left using adjusted widths and paddings */\n        .col-nature { width: 28.0%; padding-left: 3px; font-size: 8.5px; overflow: hidden; white-space: wrap; text-overflow: ellipsis; text-align: left; }\n        .col-atc { width: 7.5%; text-align: center; font-size: 9.5px; font-weight: bold; padding-right: 15px; } /* Pushed left */\n        .col-m1 { width: 12.5%; text-align: right; padding-right: 22px; font-size: 9.5px; } /* Pushed left */\n        .col-m2 { width: 14.5%; text-align: right; padding-right: 22px; font-size: 9.5px; }\n        .col-m3 { width: 14.5%; text-align: right; padding-right: 22px; font-size: 9.5px; }\n        .col-total { width: 10.0%; text-align: right; padding-right: 22px; font-size: 9.5px; font-weight: bold; } /* Pushed left */\n        .col-withheld { width: 10.0%; text-align: right; padding-right: 15px; font-size: 9.5px; font-weight: bold; }\n        \n        /* Total Row */\n        .totals-overlay {\n            position: absolute;\n            left: 2.90%;\n            top: 53.75%; /* Shifted down from 53.74% */\n            width: 94.67%;\n            display: flex;\n            height: 1.33%;\n            align-items: center;\n            font-weight: bold;\n        }\n        \n        @media print {\n            @page {\n                size: letter portrait;\n                margin: 0;\n            }\n            body {\n                margin: 0;\n                padding: 0;\n            }\n            .bir-2307-container {\n                width: 8.5in;\n                height: 11in;\n                page-break-before: avoid;\n                page-break-after: avoid;\n            }\n        }\n    </style>\n\n    <!-- Dates Parsing -->\n    {% set from_date_obj = frappe.utils.getdate(doc.from_date) if doc.from_date else None %}\n    {% set to_date_obj = frappe.utils.getdate(doc.to_date) if doc.to_date else None %}\n    \n    {% set f_month = from_date_obj.strftime(\"%m\") if from_date_obj else \"\" %}\n    {% set f_day = from_date_obj.strftime(\"%d\") if from_date_obj else \"\" %}\n    {% set f_year = from_date_obj.strftime(\"%Y\") if from_date_obj else \"\" %}\n    \n    {% set t_month = to_date_obj.strftime(\"%m\") if to_date_obj else \"\" %}\n    {% set t_day = to_date_obj.strftime(\"%d\") if to_date_obj else \"\" %}\n    {% set t_year = to_date_obj.strftime(\"%Y\") if to_date_obj else \"\" %}\n\n    <!-- From Date MM/DD/YYYY -->\n    <div class=\"date-digit\" style=\"left: 25.35%;\">{{ f_month[0] if f_month else '' }}</div>\n    <div class=\"date-digit\" style=\"left: 27.31%;\">{{ f_month[1] if f_month else '' }}</div>\n    <div class=\"date-digit\" style=\"left: 29.24%;\">{{ f_day[0] if f_day else '' }}</div>\n    <div class=\"date-digit\" style=\"left: 31.20%;\">{{ f_day[1] if f_day else '' }}</div>\n    <div class=\"date-digit\" style=\"left: 33.73%;\">{{ f_year[0] if f_year else '' }}</div>\n    <div class=\"date-digit\" style=\"left: 35.69%;\">{{ f_year[1] if f_year else '' }}</div>\n    <div class=\"date-digit\" style=\"left: 37.65%;\">{{ f_year[2] if f_year else '' }}</div>\n    <div class=\"date-digit\" style=\"left: 39.61%;\">{{ f_year[3] if f_year else '' }}</div>\n\n    <!-- To Date MM/DD/YYYY -->\n    <div class=\"date-digit\" style=\"left: 66.16%;\">{{ t_month[0] if t_month else '' }}</div>\n    <div class=\"date-digit\" style=\"left: 68.12%;\">{{ t_month[1] if t_month else '' }}</div>\n    <div class=\"date-digit\" style=\"left: 70.04%;\">{{ t_day[0] if t_day else '' }}</div>\n    <div class=\"date-digit\" style=\"left: 72.00%;\">{{ t_day[1] if t_day else '' }}</div>\n    <div class=\"date-digit\" style=\"left: 74.53%;\">{{ t_year[0] if t_year else '' }}</div>\n    <div class=\"date-digit\" style=\"left: 76.49%;\">{{ t_year[1] if t_year else '' }}</div>\n    <div class=\"date-digit\" style=\"left: 78.45%;\">{{ t_year[2] if t_year else '' }}</div>\n    <div class=\"date-digit\" style=\"left: 80.41%;\">{{ t_year[3] if t_year else '' }}</div>\n\n    <!-- Payee Info -->\n    {% set payee_tin_clean = doc.payee_tin | replace(\"-\", \"\") | replace(\" \", \"\") %}\n    {% set tin_lefts = [34.4, 36.4, 38.4, 42.75, 44.75, 46.75, 50.75, 52.75, 54.75, 59.75, 61.75, 63.75] %}\n    {% for i in range(12) %}\n        <div class=\"tin-digit\" style=\"left: {{ tin_lefts[i] }}%; top: 14.8%;\"> <!-- Shifted down from 14.25% -->\n            {{ payee_tin_clean[i] if i < payee_tin_clean|length else '' }}\n        </div>\n    {% endfor %}\n    <div class=\"field-val\" style=\"left: 15.5%; top: 18%; width: 90.5%; height: 1.44%;\">{{ doc.payee_name or '' }}</div> <!-- Shifted down and right -->\n    <div class=\"field-val\" style=\"left: 15.5%; top: 20.6%; width: 81.1%; height: 1.44%; font-size: 9.5px; font-weight: normal;\">{{ doc.payee_address or '' }}</div> <!-- Shifted down and right -->\n    <div class=\"field-val\" style=\"left: 87.84%; top: 20.6%; width: 8.63%; height: 1.44%; justify-content: center;\">{{ doc.payee_zip or '' }}</div> <!-- Shifted down -->\n\n    <!-- Payor Info -->\n    {% set payor_tin_clean = doc.payor_tin | replace(\"-\", \"\") | replace(\" \", \"\") %}\n    {% for i in range(12) %}\n        <div class=\"tin-digit\" style=\"left: {{ tin_lefts[i] }}%; top: 27%;\"> <!-- Shifted down from 26.66% -->\n            {{ payor_tin_clean[i] if i < payor_tin_clean|length else '' }}\n        </div>\n    {% endfor %}\n    <div class=\"field-val\" style=\"left: 15.5%; top: 29.8%; width: 92.5%; height: 1.44%;\">{{ doc.payor_name or '' }}</div> <!-- Shifted down and right -->\n    <div class=\"field-val\" style=\"left: 5.5%; top: 32.8%; width: 83.1%; height: 1.44%; font-size: 9.5px; font-weight: normal;\">{{ doc.payor_address or '' }}</div> <!-- Shifted down and right -->\n    <div class=\"field-val\" style=\"left: 87.84%; top: 32.8%; width: 8.63%; height: 1.44%; justify-content: center;\">{{ doc.payor_zip or '' }}</div> <!-- Shifted down -->\n\n    <!-- Part III Table Rows Overlay -->\n    <div class=\"table-overlay\">\n        {% set totals = {\n            'm1': 0.0,\n            'm2': 0.0,\n            'm3': 0.0,\n            'total': 0.0,\n            'withheld': 0.0\n        } %}\n        {% set row_tops = [0.0, 9.67, 19.33, 28.67, 38.33, 47.67, 57.33, 66.67, 76.33, 85.67] %}\n        {% for row in doc.withholding_details %}\n            {% if loop.index0 < 10 %}\n                <div class=\"overlay-row\" style=\"top: {{ row_tops[loop.index0] }}%;\">\n                    <div class=\"col-nature\">{{ row.nature_of_payment or '' }}</div>\n                    <div class=\"col-atc\">{{ row.atc or '' }}</div>\n                    <div class=\"col-m1\">{{ \"{:,.2f}\".format(row.month_1 or 0) if row.month_1 else '' }}</div>\n                    <div class=\"col-m2\">{{ \"{:,.2f}\".format(row.month_2 or 0) if row.month_2 else '' }}</div>\n                    <div class=\"col-m3\">{{ \"{:,.2f}\".format(row.month_3 or 0) if row.month_3 else '' }}</div>\n                    <div class=\"col-total\">{{ \"{:,.2f}\".format(row.total_income or 0) if row.total_income else '' }}</div>\n                    <div class=\"col-withheld\">{{ \"{:,.2f}\".format(row.tax_withheld or 0) if row.tax_withheld else '' }}</div>\n                </div>\n            {% endif %}\n            {% if totals.update({\n                'm1': totals.m1 + (row.month_1 or 0),\n                'm2': totals.m2 + (row.month_2 or 0),\n                'm3': totals.m3 + (row.month_3 or 0),\n                'total': totals.total + (row.total_income or 0),\n                'withheld': totals.withheld + (row.tax_withheld or 0)\n            }) %}{% endif %}\n        {% endfor %}\n    </div>\n\n    <!-- Totals Line -->\n    <div class=\"totals-overlay\">\n        <div class=\"col-nature\" style=\"font-weight: bold; font-size: 8px; padding-left: 5px;\"></div>\n        <div class=\"col-atc\">&nbsp;</div>\n        <div class=\"col-m1\">{{ \"{:,.2f}\".format(totals.m1) if totals.m1 else '' }}</div>\n        <div class=\"col-m2\">{{ \"{:,.2f}\".format(totals.m2) if totals.m2 else '' }}</div>\n        <div class=\"col-m3\">{{ \"{:,.2f}\".format(totals.m3) if totals.m3 else '' }}</div>\n        <div class=\"col-total\">{{ \"{:,.2f}\".format(totals.total) if totals.total else '' }}</div>\n        <div class=\"col-withheld\">{{ \"{:,.2f}\".format(totals.withheld) if totals.withheld else '' }}</div>\n    </div>\n</div>",
  "margin_top": 15.0,
  "margin_bottom": 15.0,
  "margin_left": 15.0,
  "margin_right": 15.0,
