{
 "doctype": "DocType",
 "name": "Vehicle POS Invoice",
 "module": "Vehicle Management",
 "custom": 0,
 "is_submittable": 1,
 "track_changes": 1,
 "engine": "InnoDB",
 "autoname": "naming_series:",
 "naming_rule": null,
 "title_field": "customer_name",
 "search_fields": "customer,vehicle,plate_no,posting_date",
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "options": "VMSPOS-.YYYY.-.#####",
   "default": "VMSPOS-.YYYY.-.#####",
   "label": "Series"
  },
  {
   "fieldname": "sec_customer",
   "fieldtype": "Section Break",
   "label": "Customer & Vehicle"
  },
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "options": "Customer",
   "label": "Customer",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "customer_name",
   "fieldtype": "Data",
   "label": "Customer Name",
   "fetch_from": "customer.customer_name",
   "read_only": 1
  },
  {
   "fieldname": "vehicle",
   "fieldtype": "Link",
   "options": "Customer Vehicle",
   "label": "Vehicle",
   "in_standard_filter": 1
  },
  {
   "fieldname": "plate_no",
   "fieldtype": "Data",
   "label": "Plate No",
   "fetch_from": "vehicle.plate_no",
   "read_only": 1
  },
  {
   "fieldname": "col_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "options": "Company",
   "label": "Company / Branch",
   "default": "ULTRA MRF",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "posting_date",
   "fieldtype": "Date",
   "label": "Posting Date",
   "default": "Today",
   "reqd": 1
  },
  {
   "fieldname": "cashier",
   "fieldtype": "Link",
   "options": "User",
   "label": "Cashier",
   "default": "Administrator",
   "read_only": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "options": "Draft\nSubmitted\nCancelled",
   "default": "Draft",
   "label": "Status",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "sec_items",
   "fieldtype": "Section Break",
   "label": "Items"
  },
  {
   "fieldname": "items",
   "fieldtype": "Table",
   "options": "Vehicle POS Invoice Item",
   "label": "Items"
  },
  {
   "fieldname": "sec_totals",
   "fieldtype": "Section Break",
   "label": "Totals"
  },
  {
   "fieldname": "total_qty",
   "fieldtype": "Float",
   "label": "Total Qty",
   "read_only": 1,
   "default": "0"
  },
  {
   "fieldname": "total_discount",
   "fieldtype": "Currency",
   "label": "Total Discount",
   "options": "currency",
   "read_only": 1,
   "default": "0"
  },
  {
   "fieldname": "total_amount",
   "fieldtype": "Currency",
   "label": "Total Amount",
   "options": "currency",
   "read_only": 1,
   "reqd": 1,
   "default": "0"
  },
  {
   "fieldname": "col_break_totals",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "paid_amount",
   "fieldtype": "Currency",
   "label": "Paid Amount",
   "options": "currency",
   "reqd": 1,
   "default": "0"
  },
  {
   "fieldname": "payment_method",
   "fieldtype": "Select",
   "options": "Cash\nBank Transfer\nCredit Card\nGCash\nMaya\nCheque",
   "label": "Payment Method",
   "reqd": 1,
   "default": "Cash"
  },
  {
   "fieldname": "balance_amount",
   "fieldtype": "Currency",
   "label": "Balance / Change",
   "options": "currency",
   "read_only": 1,
   "default": "0"
  },
  {
   "fieldname": "sec_ref",
   "fieldtype": "Section Break",
   "label": "Reference"
  },
  {
   "fieldname": "pos_invoice",
   "fieldtype": "Link",
   "options": "POS Invoice",
   "label": "Generated POS Invoice",
   "read_only": 1
  },
  {
   "fieldname": "remarks",
   "fieldtype": "Small Text",
   "label": "Remarks"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "export": 1
  },
  {
   "role": "Administrator",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "export": 1,
   "admin": 1
  },
  {
   "role": "Sales User",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "export": 1
  }
 ]
}
