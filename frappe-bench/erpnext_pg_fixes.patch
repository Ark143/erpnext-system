+def get_group_by_augmented(query_details, base_group_by):
+	"""PostgreSQL requires all non-aggregated SELECT columns in GROUP BY.
+	MySQL allows loose grouping; augment base group_by with the other
+	bare table.column refs selected in query_details (excluding those that
+	only appear inside aggregate functions like SUM(...))."""
+	agg_cols = set(re.findall(r"(?:SUM|MAX|MIN|AVG|COUNT)\(\s*(?:DISTINCT\s+)?([^)]*)\)", query_details))
+	agg_tokens = set()
+	for a in agg_cols:
+		agg_tokens.update(re.findall(r"t\d+\.\w+", a))
+	all_cols = re.findall(r"t\d+\.\w+", query_details)
+	aug = []
+	for c in all_cols:
+		if c == base_group_by or c in agg_tokens:
+			continue
+		if c not in aug:
+			aug.append(c)
+	return ", ".join([base_group_by] + aug)
+
