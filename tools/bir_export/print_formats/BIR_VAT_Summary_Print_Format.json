  "html": "<div class=\"bir-vat-summary-print\">\n    <style>\n        .bir-vat-summary-print {\n            font-family: \"Segoe UI\", Arial, sans-serif;\n            color: #000;\n            background-color: #fff;\n            padding: 5px;\n        }\n        .bir-header-sap {\n            margin-bottom: 12px;\n            border-bottom: 2px solid #000;\n            padding-bottom: 8px;\n        }\n        .bir-header-sap h2 {\n            text-align: center;\n            font-weight: bold;\n            text-transform: uppercase;\n            margin-top: 0;\n            margin-bottom: 10px;\n            font-size: 16px;\n            letter-spacing: 0.5px;\n        }\n        .sap-metadata-table {\n            width: 100%;\n            border-collapse: collapse;\n            font-size: 9.5px;\n            line-height: 1.3;\n        }\n        .sap-metadata-table td {\n            padding: 2px 4px !important;\n            border: none !important;\n        }\n        .sap-metadata-table td.label-cell {\n            font-weight: bold;\n            width: 12%;\n            text-align: left;\n        }\n        .sap-metadata-table td.value-cell {\n            width: 38%;\n            text-align: left;\n        }\n        .bir-period {\n            font-size: 11px;\n            font-weight: bold;\n            margin-top: 5px;\n            margin-bottom: 8px;\n            text-transform: uppercase;\n        }\n        .bir-table {\n            width: 100%;\n            border-collapse: collapse;\n            font-size: 10px;\n            margin-bottom: 25px;\n            border: 1px solid #000;\n        }\n        .bir-table th, .bir-table td {\n            border: 1px solid #000;\n            padding: 6px 8px;\n            text-align: left;\n            white-space: nowrap;\n        }\n        .bir-table th {\n            background-color: #fff;\n            font-weight: bold;\n            text-transform: uppercase;\n        }\n        .bir-table td.num-cell {\n            text-align: right;\n        }\n        .bir-summary-section {\n            width: 35%;\n            margin-top: 15px;\n            page-break-inside: avoid;\n        }\n        .footer-note {\n            margin-top: 25px;\n            font-size: 9px;\n            color: #777;\n            font-style: italic;\n        }\n    </style>\n\n    <div class=\"bir-header-sap\">\n        <h2>BIR VAT Summary Report</h2>\n        <table class=\"sap-metadata-table\">\n            <tr>\n                <td class=\"label-cell\">Company:</td>\n                <td class=\"value-cell\">{{ doc.company }}</td>\n                <td class=\"label-cell\">Line of Business:</td>\n                <td class=\"value-cell\">{{ doc.line_of_business or '' }}</td>\n            </tr>\n            <tr>\n                <td class=\"label-cell\">Address:</td>\n                <td class=\"value-cell\">{{ doc.address_display or 'Davao City, Davao Del Sur' }}</td>\n                <td class=\"label-cell\">Zip:</td>\n                <td class=\"value-cell\">{{ doc.zip or '' }}</td>\n            </tr>\n            <tr>\n                <td class=\"label-cell\">TIN:</td>\n                <td class=\"value-cell\">{{ doc.tin or '' }}</td>\n                <td class=\"label-cell\">Email:</td>\n                <td class=\"value-cell\">{{ doc.email or '' }}</td>\n            </tr>\n            <tr>\n                <td class=\"label-cell\">RDO:</td>\n                <td class=\"value-cell\">{{ doc.rdo or '' }}</td>\n                <td class=\"label-cell\">Mobile / Tel:</td>\n                <td class=\"value-cell\">\n                    {{ doc.mobile or '' }}{% if doc.telephone %} / {{ doc.telephone }}{% endif %}\n                </td>\n            </tr>\n        </table>\n    </div>\n\n    <div class=\"bir-period\">\n        Period: {{ frappe.format(doc.from_date, {fieldtype: 'Date'}) if doc.from_date else '' }} to {{ frappe.format(doc.to_date, {fieldtype: 'Date'}) if doc.to_date else '' }}\n    </div>\n\n    <table class=\"bir-table\">\n        <thead>\n            <tr>\n                <th>Category</th>\n                <th>Source</th>\n                <th style=\"text-align: right;\">Documents</th>\n                <th style=\"text-align: right;\">Taxable Amount</th>\n                <th style=\"text-align: right;\">VAT Amount</th>\n                <th style=\"text-align: right;\">Gross Amount</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for row in doc.vat_entries %}\n                <tr>\n                    <td>{{ row.category }}</td>\n                    <td>{{ row.source }}</td>\n                    <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.documents or 0) }}</td>\n                    <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.taxable_amount or 0) }}</td>\n                    <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.vat_amount or 0) }}</td>\n                    <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.gross_amount or 0) }}</td>\n                </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n\n    <div class=\"bir-summary-section\">\n        <table class=\"bir-table\">\n            <thead>\n                <tr>\n                    <th>Summary</th>\n                    <th style=\"text-align: right;\">Value</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for row in doc.total_entries %}\n                    <tr style=\"{% if row.summary == 'Net VAT Payable' %}font-weight: bold;{% endif %}\">\n                        <td>{{ row.summary }}</td>\n                        <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.value or 0) }}</td>\n                    </tr>\n                {% endfor %}\n            </tbody>\n        </table>\n    </div>\n\n    <div class=\"footer-note\">\n        Generated by ERPNext\n    </div>\n</div>",
