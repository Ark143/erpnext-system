  "html": "<div class=\"bir-gl-print\">\n    <style>\n        .bir-gl-print {\n            font-family: \"Segoe UI\", Arial, sans-serif;\n            color: #000;\n            background-color: #fff;\n            padding: 5px;\n        }\n        .bir-header-sap {\n            margin-bottom: 12px;\n            border-bottom: 2px solid #000;\n            padding-bottom: 8px;\n        }\n        .bir-header-sap h2 {\n            text-align: center;\n            font-weight: bold;\n            text-transform: uppercase;\n            margin-top: 0;\n            margin-bottom: 10px;\n            font-size: 16px;\n            letter-spacing: 0.5px;\n        }\n        .sap-metadata-table {\n            width: 100%;\n            border-collapse: collapse;\n            font-size: 9.5px;\n            line-height: 1.3;\n        }\n        .sap-metadata-table td {\n            padding: 2px 4px !important;\n            border: none !important;\n        }\n        .sap-metadata-table td.label-cell {\n            font-weight: bold;\n            width: 12%;\n            text-align: left;\n        }\n        .sap-metadata-table td.value-cell {\n            width: 38%;\n            text-align: left;\n        }\n        .bir-period {\n            font-size: 11px;\n            font-weight: bold;\n            margin-top: 5px;\n            margin-bottom: 8px;\n            text-transform: uppercase;\n        }\n        .account-group {\n            margin-bottom: 25px;\n            page-break-inside: avoid;\n        }\n        .account-title {\n            font-size: 11px;\n            font-weight: bold;\n            margin-bottom: 6px;\n            text-transform: uppercase;\n        }\n        .bir-table {\n            width: 100%;\n            border-collapse: collapse;\n            font-size: 9.5px;\n        }\n        .bir-table th, .bir-table td {\n            border: 1px solid #000;\n            padding: 4px 6px;\n            text-align: left;\n            white-space: nowrap; /* Prevent wrap */\n        }\n        .bir-table th {\n            background-color: #fff;\n            font-weight: bold;\n            text-align: center;\n            text-transform: uppercase;\n        }\n        .bir-table td.num-cell {\n            text-align: right;\n        }\n        .bir-table tr.total-row td {\n            font-weight: bold;\n        }\n    </style>\n\n    <div class=\"bir-header-sap\">\n        <h2>BIR General Ledger</h2>\n        <table class=\"sap-metadata-table\">\n            <tr>\n                <td class=\"label-cell\">Company:</td>\n                <td class=\"value-cell\">{{ doc.company }}</td>\n                <td class=\"label-cell\">Line of Business:</td>\n                <td class=\"value-cell\">{{ doc.line_of_business or '' }}</td>\n            </tr>\n            <tr>\n                <td class=\"label-cell\">Address:</td>\n                <td class=\"value-cell\">{{ doc.address_display or 'Davao City, Davao Del Sur' }}</td>\n                <td class=\"label-cell\">Zip:</td>\n                <td class=\"value-cell\">{{ doc.zip or '' }}</td>\n            </tr>\n            <tr>\n                <td class=\"label-cell\">TIN:</td>\n                <td class=\"value-cell\">{{ doc.tin or '' }}</td>\n                <td class=\"label-cell\">Email:</td>\n                <td class=\"value-cell\">{{ doc.email or '' }}</td>\n            </tr>\n            <tr>\n                <td class=\"label-cell\">RDO:</td>\n                <td class=\"value-cell\">{{ doc.rdo or '' }}</td>\n                <td class=\"label-cell\">Mobile / Tel:</td>\n                <td class=\"value-cell\">\n                    {{ doc.mobile or '' }}{% if doc.telephone %} / {{ doc.telephone }}{% endif %}\n                </td>\n            </tr>\n        </table>\n    </div>\n\n    <div class=\"bir-period\">\n        Period: {{ frappe.format(doc.from_date, {fieldtype: 'Date'}) if doc.from_date else '' }} to {{ frappe.format(doc.to_date, {fieldtype: 'Date'}) if doc.to_date else '' }}\n    </div>\n\n    {# Group and render transactions by Account #}\n    {% set grouped_accounts = [] %}\n    {% for row in doc.gl_entries %}\n        {% if row.account not in grouped_accounts %}\n            {% if grouped_accounts.append(row.account) %}{% endif %}\n        {% endif %}\n    {% endfor %}\n\n    {% for account in grouped_accounts | sort %}\n        <div class=\"account-group\">\n            {% set parts = account.split(' - ') %}\n            <div class=\"account-title\">\n                {{ parts[0] or '' }}{% if parts[1] %} - {{ parts[1] }}{% endif %}\n            </div>\n            \n            <table class=\"bir-table\">\n                <thead>\n                    <tr>\n                        <th style=\"width: 15%;\">Date</th>\n                        <th style=\"width: 55%;\">Description</th>\n                        <th style=\"width: 10%;\">Debit</th>\n                        <th style=\"width: 10%;\">Credit</th>\n                        <th style=\"width: 10%;\">Balance</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    {% for row in doc.gl_entries %}\n                        {% if row.account == account %}\n                            {% if row.is_total_row %}\n                                <tr class=\"total-row\">\n                                    <td colspan=\"2\">TOTAL</td>\n                                    <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.debit or 0) }}</td>\n                                    <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.credit or 0) }}</td>\n                                    <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.balance or 0) }}</td>\n                                </tr>\n                            {% else %}\n                                <tr>\n                                    <td style=\"white-space: nowrap;\">{{ frappe.format(row.date, {fieldtype: 'Date'}) if row.date else '' }}</td>\n                                    <td>{{ row.description or '' }}</td>\n                                    <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.debit or 0) }}</td>\n                                    <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.credit or 0) }}</td>\n                                    <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.balance or 0) }}</td>\n                                </tr>\n                            {% endif %}\n                        {% endif %}\n                    {% endfor %}\n                </tbody>\n            </table>\n        </div>\n    {% endfor %}\n</div>",
  "margin_top": 15.0,
  "margin_bottom": 15.0,
  "margin_left": 15.0,
  "margin_right": 15.0,
