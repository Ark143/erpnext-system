  "raw_printing": 0,
  "html": "<div class=\"bir-sj-print\">\n    <style>\n        .bir-sj-print {\n            font-family: \"Segoe UI\", Arial, sans-serif;\n            color: #000;\n            background-color: #fff;\n            padding: 5px;\n        }\n        .bir-header-sap {\n            margin-bottom: 12px;\n            border-bottom: 2px solid #000;\n            padding-bottom: 8px;\n        }\n        .bir-header-sap h2 {\n            text-align: center;\n            font-weight: bold;\n            text-transform: uppercase;\n            margin-top: 0;\n            margin-bottom: 10px;\n            font-size: 16px;\n            letter-spacing: 0.5px;\n        }\n        .sap-metadata-table {\n            width: 100%;\n            border-collapse: collapse;\n            font-size: 9.5px;\n            line-height: 1.3;\n        }\n        .sap-metadata-table td {\n            padding: 2px 4px !important;\n            border: none !important;\n        }\n        .sap-metadata-table td.label-cell {\n            font-weight: bold;\n            width: 12%;\n            text-align: left;\n        }\n        .sap-metadata-table td.value-cell {\n            width: 38%;\n            text-align: left;\n        }\n        .bir-period {\n            font-size: 11px;\n            font-weight: bold;\n            margin-top: 5px;\n            margin-bottom: 8px;\n            text-transform: uppercase;\n        }\n        .bir-table {\n            width: 100%;\n            border-collapse: collapse;\n            font-size: 9.5px;\n        }\n        .bir-table th, .bir-table td {\n            border: 1px solid #000;\n            padding: 4px 6px;\n            text-align: left;\n            white-space: nowrap; /* Prevent wrap */\n        }\n        .bir-table th {\n            background-color: #fff;\n            font-weight: bold;\n            text-align: center;\n            text-transform: uppercase;\n        }\n        .bir-table td.num-cell {\n            text-align: right;\n        }\n        .bir-table tr.total-row td {\n            font-weight: bold;\n        }\n        .bir-summary-section {\n            margin-top: 20px;\n            page-break-inside: avoid;\n        }\n        .bir-summary-section h3 {\n            font-size: 11px;\n            font-weight: bold;\n            text-transform: uppercase;\n            margin-bottom: 8px;\n            border-bottom: 1px solid #000;\n            padding-bottom: 2px;\n            width: fit-content;\n        }\n        @media print {\n            @page {\n                size: landscape;\n                margin: 6mm 4mm 4mm 4mm;\n            }\n            .bir-sj-print {\n                width: 100%;\n            }\n            .bir-table {\n                font-size: 7.5px;\n            }\n            .sap-metadata-table {\n                font-size: 8.5px;\n            }\n        }\n    </style>\n\n    <div class=\"bir-header-sap\">\n        <h2>Sales Journal</h2>\n        <table class=\"sap-metadata-table\">\n            <tr>\n                <td class=\"label-cell\">Company:</td>\n                <td class=\"value-cell\">{{ doc.company }}</td>\n                <td class=\"label-cell\">Line of Business:</td>\n                <td class=\"value-cell\">{{ doc.line_of_business or '' }}</td>\n            </tr>\n            <tr>\n                <td class=\"label-cell\">Address:</td>\n                <td class=\"value-cell\">{{ doc.address_display or 'Davao City, Davao Del Sur' }}</td>\n                <td class=\"label-cell\">Zip:</td>\n                <td class=\"value-cell\">{{ doc.zip or '' }}</td>\n            </tr>\n            <tr>\n                <td class=\"label-cell\">TIN:</td>\n                <td class=\"value-cell\">{{ doc.tin or '' }}</td>\n                <td class=\"label-cell\">Email:</td>\n                <td class=\"value-cell\">{{ doc.email or '' }}</td>\n            </tr>\n            <tr>\n                <td class=\"label-cell\">RDO:</td>\n                <td class=\"value-cell\">{{ doc.rdo or '' }}</td>\n                <td class=\"label-cell\">Mobile / Tel:</td>\n                <td class=\"value-cell\">\n                    {{ doc.mobile or '' }}{% if doc.telephone %} / {{ doc.telephone }}{% endif %}\n                </td>\n            </tr>\n        </table>\n    </div>\n\n    <div class=\"bir-period\">\n        Period: {{ frappe.format(doc.from_date, {fieldtype: 'Date'}) if doc.from_date else '' }} to {{ frappe.format(doc.to_date, {fieldtype: 'Date'}) if doc.to_date else '' }}\n    </div>\n\n    <div style=\"overflow-x: auto; -webkit-overflow-scrolling: touch; width: 100%; margin-bottom: 20px;\">\n        <table class=\"bir-table\">\n            <thead>\n                <tr>\n                    <th>Entry Date</th>\n                    <th>Payor</th>\n                    <th>TIN</th>\n                    <th>Address</th>\n                    <th>Invoice No.</th>\n                    <th>Goods/Services</th>\n                    <th>Discount Type</th>\n                    <th>Discount Amount</th>\n                    <th>VATable Sales</th>\n                    <th>Output VAT</th>\n                    <th>Zero-Rated</th>\n                    <th>VAT-Exempt</th>\n                    <th>Total Sales</th>\n                    <th>W/Tax</th>\n                    <th>Total Receivable</th>\n                    <th>Status / Ref. / Date</th>\n                    <th>Payment Date</th>\n                    <th>Remarks</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% set totals = {\n                    'discount': 0.0,\n                    'vatable': 0.0,\n                    'output_vat': 0.0,\n                    'zero_rated': 0.0,\n                    'exempt': 0.0,\n                    'total_sales': 0.0,\n                    'w_tax': 0.0,\n                    'total_receivable': 0.0\n                } %}\n                {% for row in doc.sales_entries %}\n                    <tr>\n                        <td style=\"white-space: nowrap;\">{{ frappe.format(row.date, {fieldtype: 'Date'}) if row.date else '' }}</td>\n                        <td>{{ row.payor or '' }}</td>\n                        <td>{{ row.tin or '' }}</td>\n                        <td>{{ row.address or '' }}</td>\n                        <td>{{ row.invoice_no or '' }}</td>\n                        <td style=\"text-align: center;\">{{ row.goods_services or '' }}</td>\n                        <td>{{ row.discount_type or 'NONE' }}</td>\n                        <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.discount_amount or 0) }}</td>\n                        <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.vatable_sales or 0) }}</td>\n                        <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.output_vat or 0) }}</td>\n                        <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.zero_rated or 0) }}</td>\n                        <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.vat_exempt or 0) }}</td>\n                        <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.total_sales or 0) }}</td>\n                        <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.w_tax or 0) }}</td>\n                        <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.total_receivable or 0) }}</td>\n                        <td style=\"font-weight: bold; text-align: center; color: #000;\">{{ row.status_ref_date or '' }}</td>\n                        <td style=\"text-align: center;\">{{ row.payment_date or '-' }}</td>\n                        <td>{{ row.remarks or '' }}</td>\n                    </tr>\n                    {% if totals.update({\n                        'discount': totals.discount + (row.discount_amount or 0),\n                        'vatable': totals.vatable + (row.vatable_sales or 0),\n                        'output_vat': totals.output_vat + (row.output_vat or 0),\n                        'zero_rated': totals.zero_rated + (row.zero_rated or 0),\n                        'exempt': totals.exempt + (row.vat_exempt or 0),\n                        'total_sales': totals.total_sales + (row.total_sales or 0),\n                        'w_tax': totals.w_tax + (row.w_tax or 0),\n                        'total_receivable': totals.total_receivable + (row.total_receivable or 0)\n                    }) %}{% endif %}\n                {% endfor %}\n                <tr class=\"total-row\">\n                    <td colspan=\"7\">TOTAL</td>\n                    <td class=\"num-cell\">{{ \"{:,.2f}\".format(totals.discount) }}</td>\n                    <td class=\"num-cell\">{{ \"{:,.2f}\".format(totals.vatable) }}</td>\n                    <td class=\"num-cell\">{{ \"{:,.2f}\".format(totals.output_vat) }}</td>\n                    <td class=\"num-cell\">{{ \"{:,.2f}\".format(totals.zero_rated) }}</td>\n                    <td class=\"num-cell\">{{ \"{:,.2f}\".format(totals.exempt) }}</td>\n                    <td class=\"num-cell\">{{ \"{:,.2f}\".format(totals.total_sales) }}</td>\n                    <td class=\"num-cell\">{{ \"{:,.2f}\".format(totals.w_tax) }}</td>\n                    <td class=\"num-cell\">{{ \"{:,.2f}\".format(totals.total_receivable) }}</td>\n                    <td></td>\n                    <td></td>\n                    <td></td>\n                </tr>\n            </tbody>\n        </table>\n    </div>\n\n    <div class=\"bir-summary-section\">\n        <h3>Summary</h3>\n        <table class=\"bir-table\" style=\"width: 35%;\">\n            <thead>\n                <tr>\n                    <th>Summary</th>\n                    <th>Value</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for row in doc.summary_entries %}\n                    <tr>\n                        <td>{{ row.summary }}</td>\n                        <td class=\"num-cell\">\n                            {% if row.summary == 'Documents' %}\n                                {{ \"{:,.2f}\".format(row.value or 0) }}\n                            {% else %}\n                                {{ \"{:,.2f}\".format(row.value or 0) }}\n                            {% endif %}\n                        </td>\n                    </tr>\n                {% endfor %}\n            </tbody>\n        </table>\n    </div>\n</div>",
  "margin_top": 15.0,
  "margin_bottom": 15.0,
  "margin_left": 15.0,
  "margin_right": 15.0,
