  "html": "<p style=\"font-size:9px\">Cash/bank movements from posted ledger entries. Source references may be payments, invoices or journal entries. Tax/discount breakdowns are unclassified until approved mappings are configured.</p>{% set bir_company = frappe.get_doc('Company', doc.company) %}\n<div class=\"bir-crj-print\">\n    <style>\n        .bir-crj-print {\n            font-family: \"Segoe UI\", Arial, sans-serif;\n            color: #000;\n            background-color: #fff;\n            padding: 5px;\n        }\n        .bir-header-sap {\n            margin-bottom: 12px;\n            border-bottom: 2px solid #000;\n            padding-bottom: 8px;\n        }\n        .bir-header-sap h2 {\n            text-align: center;\n            font-weight: bold;\n            text-transform: uppercase;\n            margin-top: 0;\n            margin-bottom: 10px;\n            font-size: 16px;\n            letter-spacing: 0.5px;\n        }\n        .sap-metadata-table {\n            width: 100%;\n            border-collapse: collapse;\n            font-size: 9.5px;\n            line-height: 1.3;\n        }\n        .sap-metadata-table td {\n            padding: 2px 4px !important;\n            border: none !important;\n        }\n        .sap-metadata-table td.label-cell {\n            font-weight: bold;\n            width: 12%;\n            text-align: left;\n        }\n        .sap-metadata-table td.value-cell {\n            width: 38%;\n            text-align: left;\n        }\n        .bir-period {\n            font-size: 11px;\n            font-weight: bold;\n            margin-top: 5px;\n            margin-bottom: 8px;\n            text-transform: uppercase;\n        }\n        .bir-table {\n            width: 100%;\n            border-collapse: collapse;\n            font-size: 9.5px;\n        }\n        .bir-table th, .bir-table td {\n            border: 1px solid #000;\n            padding: 4px 6px;\n            text-align: left;\n            white-space: nowrap; /* Prevent wrap */\n        }\n        .bir-table th {\n            background-color: #fff;\n            font-weight: bold;\n            text-align: center;\n            text-transform: uppercase;\n        }\n        .bir-table td.num-cell {\n            text-align: right;\n        }\n        .bir-table tr.total-row td {\n            font-weight: bold;\n        }\n        .bir-summary-section {\n            margin-top: 20px;\n            page-break-inside: avoid;\n        }\n        .bir-summary-section h3 {\n            font-size: 11px;\n            font-weight: bold;\n            text-transform: uppercase;\n            margin-bottom: 4px;\n            border-bottom: 1px solid #000;\n            padding-bottom: 2px;\n            width: fit-content;\n        }\n        .bir-summary-period {\n            font-size: 10px;\n            margin-bottom: 8px;\n            font-style: italic;\n        }\n        @media print {\n            @page {\n                size: landscape;\n                margin: 6mm 4mm 4mm 4mm;\n            }\n            .bir-crj-print {\n                width: 100%;\n            }\n            .bir-table {\n                font-size: 7.5px;\n            }\n            .sap-metadata-table {\n                font-size: 8.5px;\n            }\n        }\n    </style>\n\n    <div class=\"bir-header-sap\">\n        <h2>Cash Receipt Journal</h2>\n        <table class=\"sap-metadata-table\">\n            <tr>\n                <td class=\"label-cell\">Company:</td>\n                <td class=\"value-cell\">{{ bir_company.company_name or doc.company }}</td>\n                <td class=\"label-cell\">Line of Business:</td>\n                <td class=\"value-cell\">{{ doc.line_of_business or '' }}</td>\n            </tr>\n            <tr>\n                <td class=\"label-cell\">Address:</td>\n                <td class=\"value-cell\">{{ doc.address_display or '' }}</td>\n                <td class=\"label-cell\">Zip:</td>\n                <td class=\"value-cell\">{{ doc.zip or '' }}</td>\n            </tr>\n            <tr>\n                <td class=\"label-cell\">TIN:</td>\n                <td class=\"value-cell\">{{ bir_company.tax_id or '' }}</td>\n                <td class=\"label-cell\">Email:</td>\n                <td class=\"value-cell\">{{ doc.email or '' }}</td>\n            </tr>\n            <tr>\n                <td class=\"label-cell\">RDO:</td>\n                <td class=\"value-cell\">{{ doc.rdo or '' }}</td>\n                <td class=\"label-cell\">Mobile / Tel:</td>\n                <td class=\"value-cell\">\n                    {{ doc.mobile or '' }}{% if doc.telephone %} / {{ doc.telephone }}{% endif %}\n                </td>\n            </tr>\n        </table>\n    </div>\n\n    <div class=\"bir-period\">\n        Period: {{ frappe.format(doc.from_date, {fieldtype: 'Date'}) if doc.from_date else '' }} to {{ frappe.format(doc.to_date, {fieldtype: 'Date'}) if doc.to_date else '' }}\n    </div>\n\n    <div style=\"overflow-x: auto; -webkit-overflow-scrolling: touch; width: 100%; margin-bottom: 20px;\">\n        <table class=\"bir-table\">\n            <thead>\n                <tr>\n                    <th>Date</th>\n                    <th>Payor</th>\n                    <th>TIN</th>\n                    <th>Address</th>\n                    <th>Source Voucher</th>\n                    <th>Rendered</th>\n                    <th>Discount Type</th>\n                    <th>Discount Amount</th>\n                    <th>VATable</th>\n                    <th>Output VAT</th>\n                    <th>Zero-Rated</th>\n                    <th>VAT-Exempt</th>\n                    <th>Total</th>\n                    <th>W/Tax</th>\n                    <th>Net Cash</th>\n                    <th>Note</th>\n                    <th>Status</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% set totals = {\n                    'discount': 0.0,\n                    'vatable': 0.0,\n                    'output_vat': 0.0,\n                    'zero_rated': 0.0,\n                    'exempt': 0.0,\n                    'total': 0.0,\n                    'w_tax': 0.0,\n                    'net_cash': 0.0\n                } %}\n                {% for row in doc.journal_entries %}\n                    <tr>\n                        <td style=\"white-space: nowrap;\">{{ frappe.format(row.date, {fieldtype: 'Date'}) if row.date else '' }}</td>\n                        <td>{{ row.payor or '' }}</td>\n                        <td>{{ row.tin or '' }}</td>\n                        <td>{{ row.address or '' }}</td>\n                        <td>{{ row.invoice_no or '' }}</td>\n                        <td style=\"text-align: center;\">{{ row.rendered or '' }}</td>\n                        <td>\u2014</td>\n                        <td class=\"num-cell\">\u2014</td>\n                        <td class=\"num-cell\">\u2014</td>\n                        <td class=\"num-cell\">\u2014</td>\n                        <td class=\"num-cell\">\u2014</td>\n                        <td class=\"num-cell\">\u2014</td>\n                        <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.total or 0) }}</td>\n                        <td class=\"num-cell\">\u2014</td>\n                        <td class=\"num-cell\">{{ \"{:,.2f}\".format(row.net_cash or 0) }}</td>\n                        <td>{{ row.note or '' }}</td>\n                        <td style=\"font-weight: bold; text-align: center; color: {% if row.status == 'UNPAID' %}#ff0000{% else %}#000{% endif %};\">{{ row.status or '' }}</td>\n                    </tr>\n                    {% if totals.update({\n                        'discount': totals.discount + (row.discount_amount or 0),\n                        'vatable': totals.vatable + (row.vatable or 0),\n                        'output_vat': totals.output_vat + (row.output_vat or 0),\n                        'zero_rated': totals.zero_rated + (row.zero_rated or 0),\n                        'exempt': totals.exempt + (row.vat_exempt or 0),\n                        'total': totals.total + (row.total or 0),\n                        'w_tax': totals.w_tax + (row.w_tax or 0),\n                        'net_cash': totals.net_cash + (row.net_cash or 0)\n                    }) %}{% endif %}\n                {% endfor %}\n                <tr class=\"total-row\">\n                    <td colspan=\"7\">TOTAL</td>\n                    <td class=\"num-cell\">\u2014</td>\n                    <td class=\"num-cell\">\u2014</td>\n                    <td class=\"num-cell\">\u2014</td>\n                    <td class=\"num-cell\">\u2014</td>\n                    <td class=\"num-cell\">\u2014</td>\n                    <td class=\"num-cell\">{{ \"{:,.2f}\".format(totals.total) }}</td>\n                    <td class=\"num-cell\">\u2014</td>\n                    <td class=\"num-cell\">{{ \"{:,.2f}\".format(totals.net_cash) }}</td>\n                    <td></td>\n                    <td></td>\n                </tr>\n            </tbody>\n        </table>\n    </div>\n\n    <div class=\"bir-summary-section\">\n        <h3>ACCOUNT SUMMARY</h3>\n        {% if doc.from_date %}\n            {% set from_date_obj = frappe.utils.getdate(doc.from_date) %}\n            <div class=\"bir-summary-period\">Period: {{ doc.from_date }} to {{ doc.to_date }}</div>\n        {% endif %}\n        <table class=\"bir-table\" style=\"width: 50%;\">\n            <thead>\n                <tr>\n                    <th style=\"width: 50%;\">Account Title</th>\n                    <th style=\"width: 25%;\">Debit</th>\n                    <th style=\"width: 25%;\">Credit</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for row in doc.account_summary %}\n                    <tr class=\"{% if row.account_title == 'Total' %}total-row{% endif %}\">\n                        <td>{{ row.account_title }}</td>\n                        <td class=\"num-cell\">\n                            {% if row.debit > 0 or row.account_title == 'Total' %}\n                                {{ \"{:,.2f}\".format(row.debit or 0) }}\n                            {% endif %}\n                        </td>\n                        <td class=\"num-cell\">\n                            {% if row.credit > 0 or row.account_title == 'Total' %}\n                                {{ \"{:,.2f}\".format(row.credit or 0) }}\n                            {% endif %}\n                        </td>\n                    </tr>\n                {% endfor %}\n            </tbody>\n        </table>\n    </div>\n</div><style>\n        .bir-table { width:100%; table-layout:fixed; }\n        .bir-table th, .bir-table td { white-space:normal !important; overflow-wrap:anywhere; word-wrap:break-word; padding:3px 2px; }\n        .bir-table thead { display:table-header-group; }\n        .bir-table tr { page-break-inside:avoid; }\n        @media print { .bir-table { font-size:7.5px; } }\n        </style>",
  "margin_top": 15.0,
  "margin_bottom": 15.0,
  "margin_left": 15.0,
  "margin_right": 15.0,
